{% comment %}
  Range product page or legacy collection quick-order page for separately stocked products.
  The initial page is server-rendered; subsequent pages append without replacing selections.
  @example Assign product.range-order and select custom.order_table_collection on the product.
{% endcomment %}
{% liquid
  assign order_source = collection
  assign range_resource = collection
  if request.page_type == 'product'
    assign range_resource = product
    assign order_source = product.metafields.custom.order_table_collection.value
    assign brand_collection = product.metafields.custom.range_brand.value
  endif
  assign hero_image = section.settings.image | default: range_resource.featured_image | default: range_resource.image
  assign surface = section.settings.background_style | default: 'paper'
%}
<script src="{{ 'carpe-collection-order.js' | asset_url }}" type="module" fetchpriority="low"></script>
<div class="section-background color-{{ section.settings.color_scheme }} carpe-order-background carpe-order-background--{{ surface }}"{% if surface == 'paper' %} style="--carpe-order-artwork: url('{{ 'carpe-drafting-studio-background.webp' | asset_url }}');"{% endif %}></div>
<div class="section section--page-width color-{{ section.settings.color_scheme }} carpe-order-section" data-animate="{{ section.settings.enable_animation }}">
  <carpe-collection-order-component
    id="CarpeOrder-{{ section.id }}" class="carpe-order"
    data-section-id="{{ section.id }}" data-auto-load="{{ section.settings.auto_load }}"
    data-add-url="{{ routes.cart_add_url | append: '.js' }}"
    data-cart-url="{{ routes.cart_url | append: '.js' }}"
    data-cart-animation="{{ settings.add_to_cart_animation }}"
    {% if order_source != blank %}data-group-index-url="{{ order_source.url | append: '?view=order-groups' | escape }}"{% endif %}
  >
    <nav class="carpe-order__breadcrumbs" aria-label="{{ 'carpe_order.breadcrumbs' | t | escape }}">
      <a href="{{ routes.root_url }}">{{ 'carpe_order.home' | t }}</a>
      {% if brand_collection != blank %}<span aria-hidden="true">/</span><a href="{{ brand_collection.url }}">{{ brand_collection.title | escape }}</a>{% endif %}
      <span aria-hidden="true">/</span><span aria-current="page">{{ range_resource.title | escape }}</span>
    </nav>
    <header class="carpe-order__intro{% unless hero_image %} carpe-order__intro--text-only{% endunless %}">
      {% if hero_image %}
        <figure class="carpe-order__visual">
          <div class="carpe-order__image-frame">
            {{ hero_image | image_url: width: 900 | image_tag: widths: '320, 480, 720, 900', sizes: '(min-width: 990px) 420px, (min-width: 750px) 40vw, 90vw', loading: 'eager', class: 'carpe-order__hero' }}
          </div>
          {% if order_source != blank %}<figcaption class="carpe-order__image-caption">{{ 'content.item_count' | t: count: order_source.products_count }}</figcaption>{% endif %}
        </figure>
      {% endif %}
      <div class="carpe-order__details">
        {% if brand_collection != blank %}<a class="carpe-order__brand" href="{{ brand_collection.url }}">{{ brand_collection.title | escape }}</a>{% endif %}
        <p class="carpe-order__eyebrow">{{ 'carpe_order.eyebrow' | t }}</p>
        <h1>{{ range_resource.title | escape }}</h1>
        {% if range_resource.description != blank %}<div class="rte carpe-order__description">{{ range_resource.description }}</div>{% endif %}
        <p class="carpe-order__introduction">{{ 'carpe_order.introduction' | t }}</p>
        {% if order_source.products_count > 0 %}<a class="carpe-order__browse" href="#CarpeOptions-{{ section.id }}">{{ 'carpe_order.browse_options' | t }}<span aria-hidden="true">↘</span></a>{% endif %}
        <ol class="carpe-order__steps">
          <li><span aria-hidden="true">01</span>{{ 'carpe_order.choose_items' | t }}</li>
          <li><span aria-hidden="true">02</span>{{ 'carpe_order.set_quantities' | t }}</li>
          <li><span aria-hidden="true">03</span>{{ 'carpe_order.add_selected' | t }}</li>
        </ol>
      </div>
    </header>
    {% if order_source != blank %}
    {% paginate order_source.products by section.settings.products_per_page %}
      {% if order_source.products.size > 0 %}
        <div class="carpe-order__options-heading" id="CarpeOptions-{{ section.id }}">
          <div><p class="carpe-order__eyebrow">{{ 'carpe_order.eyebrow' | t }}</p><h2>{{ 'carpe_order.choose_options' | t }}</h2></div>
          <span class="carpe-order__count">{{ 'content.item_count' | t: count: order_source.products_count }}</span>
        </div>
        <div class="carpe-order__tabs" data-order-tabs role="tablist" aria-label="{{ 'carpe_order.groups' | t | escape }}" on:click="/selectGroup" on:keydown="/groupKeydown" hidden></div>
        <p class="carpe-order__group-status" data-order-group-status role="status"></p>
        <button type="button" class="button-secondary carpe-order__group-retry" data-order-group-retry on:click="/loadGroupIndex" hidden>{{ 'carpe_order.retry_groups' | t }}</button>
        <div class="carpe-order__toolbar carpe-order__enhanced">
          <p>{{ 'carpe_order.selected' | t }} <strong data-order-count>0</strong></p>
          <button type="button" class="button-secondary" data-order-clear on:click="/clearSelection">{{ 'carpe_order.clear' | t }}</button>
          <button type="button" class="button" data-order-submit on:click="/addSelected" disabled>{{ 'carpe_order.add_selected' | t }}</button>
          <a href="{{ routes.cart_url }}">{{ 'content.view_cart' | t }}</a>
          <p class="carpe-order__status" data-order-status role="status"></p>
        </div>
        <p class="carpe-order__scroll-hint" id="CarpeScroll-{{ section.id }}">{{ 'carpe_order.scroll_hint' | t }}</p>
        <p class="carpe-order__group-empty" data-order-group-empty hidden>{{ 'carpe_order.group_pending' | t }}</p>
        <div class="carpe-order__scroll" id="CarpeTable-{{ section.id }}" tabindex="0" role="region" aria-label="{{ 'carpe_order.table_label' | t | escape }}" aria-describedby="CarpeScroll-{{ section.id }}">
          <table class="carpe-order__table">
            <caption class="visually-hidden">{{ range_resource.title | escape }}</caption>
            <thead><tr>
              {% if section.settings.show_images %}<th scope="col">{{ 'carpe_order.color_image' | t }}</th>{% endif %}
              <th scope="col">{{ 'carpe_order.sku' | t }}</th>
              <th scope="col">{{ 'carpe_order.product' | t }}</th>
              {% if section.settings.show_barcode %}<th scope="col">{{ 'carpe_order.barcode' | t }}</th>{% endif %}
              <th scope="col">{{ 'content.price' | t }}</th>
              <th scope="col">{{ 'content.quantity' | t }}</th>
            </tr></thead>
            <tbody data-order-rows>
              {% for item in order_source.products %}
                {% render 'carpe-order-row', item: item, section_id: section.id, show_images: section.settings.show_images, show_barcode: section.settings.show_barcode %}
              {% endfor %}
            </tbody>
          </table>
        </div>
        <nav class="carpe-order__pagination" aria-label="{{ 'content.pagination.nav_label' | t | escape }}">
          {% if paginate.previous %}<a href="{{ paginate.previous.url }}">{{ 'content.pagination.previous' | t }}</a>{% endif %}
          <a data-order-next {% if paginate.next %}href="{{ paginate.next.url }}"{% else %}hidden{% endif %} on:click="/loadMore">{{ 'carpe_order.load_more' | t }}</a>
        </nav>
        <p data-load-status role="status" class="carpe-order__load-status"></p>
      {% else %}
        <p>{{ 'content.no_products_found' | t }}</p>
      {% endif %}
    {% endpaginate %}
    {% else %}
      <p>{{ 'content.no_products_found' | t }}</p>
    {% endif %}
    <script type="application/json" data-order-messages>
      {
        "loading": {{ 'carpe_order.loading' | t | json }},
        "loadError": {{ 'carpe_order.load_error' | t | json }},
        "invalid": {{ 'carpe_order.invalid_quantity' | t | json }},
        "adding": {{ 'carpe_order.adding' | t | json }},
        "success": {{ 'carpe_order.success' | t | json }},
        "cartError": {{ 'carpe_order.cart_error' | t | json }},
        "syncError": {{ 'carpe_order.sync_error' | t | json }},
        "otherGroup": {{ 'carpe_order.other_group' | t | json }},
        "groupError": {{ 'carpe_order.group_error' | t | json }},
        "inCartQuantity": {{ 'carpe_order.in_cart_quantity' | t: count: '__count__' | json }}
      }
    </script>
    <template data-order-flight>
      <span class="carpe-order-flight__icon">{{ 'icon-cart.svg' | inline_asset_content }}</span>
      <span class="carpe-order-flight__count" data-order-flight-count></span>
    </template>
    <template data-order-success-icon>
      <span class="carpe-order__success-icon" aria-hidden="true">{{ 'icon-checkmark.svg' | inline_asset_content }}</span>
    </template>
  </carpe-collection-order-component>
</div>
{% render 'fly-to-cart-styles' %}
{% stylesheet %}
  /* Keep artwork and fade on one surface so neither can end before the other. */
  .carpe-order-background--paper::before {
    content: '';
    position: absolute;
    inset-block-start: 0;
    inset-inline: 0;
    block-size: clamp(650px, 66.667vw, 1100px);
    max-block-size: 100%;
    pointer-events: none;
    background-image: linear-gradient(180deg, rgb(var(--color-background-rgb) / 0.38), rgb(var(--color-background-rgb) / 0.68) 52%, var(--color-background) 96%), var(--carpe-order-artwork);
    background-position: top center;
    background-size: cover;
    background-repeat: no-repeat;
  }
  .carpe-order-section { padding-block: 24px clamp(40px, 5vw, 80px); }
  .carpe-order {
    --carpe-order-border: rgb(var(--color-foreground-rgb) / 0.12);
    --carpe-order-soft: color-mix(in srgb, var(--color-background) 97%, var(--color-foreground));
    --carpe-order-radius: var(--style-border-radius-lg, 16px);
    display: block; min-width: 0; color: var(--color-foreground);
  }
  .carpe-order__breadcrumbs { display: flex; align-items: center; flex-wrap: wrap; gap: 10px; font-size: 0.75rem; margin-block-end: clamp(24px, 3vw, 40px); color: var(--color-foreground-muted); }
  .carpe-order__breadcrumbs a { color: inherit; text-decoration: none; text-underline-offset: 4px; }
  .carpe-order__breadcrumbs a:hover { text-decoration: underline; }
  .carpe-order__breadcrumbs [aria-current] { overflow-wrap: anywhere; }
  .carpe-order__intro { display: grid; grid-template-columns: minmax(260px, 0.85fr) minmax(0, 1.4fr); align-items: center; gap: clamp(28px, 5vw, 80px); margin-block-end: clamp(36px, 5vw, 64px); }
  .carpe-order__intro--text-only { grid-template-columns: 1fr; }
  .carpe-order__visual { position: relative; margin: 0; min-width: 0; }
  .carpe-order__image-frame { display: grid; place-items: center; aspect-ratio: 1.12; padding: clamp(24px, 4vw, 48px); border: 1px solid var(--carpe-order-border); border-radius: var(--carpe-order-radius); background: var(--carpe-order-soft); box-shadow: 0 18px 50px -38px rgb(var(--color-foreground-rgb) / 0.3); overflow: hidden; }
  .carpe-order__hero { display: block; width: 100%; height: 100%; max-height: 340px; object-fit: contain; border-radius: var(--style-border-radius-sm, 8px); transition: transform 400ms ease; }
  .carpe-order__image-caption { position: absolute; inset-block-end: 16px; inset-inline-start: 16px; padding: 7px 12px; border: 1px solid var(--carpe-order-border); border-radius: 999px; font-size: 0.75rem; background: var(--color-background); }
  .carpe-order__details { min-width: 0; }
  .carpe-order__brand { display: inline-flex; align-items: center; min-height: 28px; padding: 4px 12px; margin-block-end: 16px; border: 1px solid var(--carpe-order-border); border-radius: 999px; color: inherit; font-size: 0.72rem; font-weight: 600; letter-spacing: 0.08em; text-decoration: none; }
  .carpe-order__eyebrow { margin-block: 0 10px; font-size: 0.65rem; line-height: 1.4; font-weight: 700; letter-spacing: 0.16em; text-transform: uppercase; color: var(--color-foreground-muted); }
  .carpe-order__intro h1 { font-family: var(--font-heading--family); font-size: clamp(1.8rem, 3.2vw, 3rem); line-height: 1.1; letter-spacing: -0.035em; margin-block: 0 20px; overflow-wrap: anywhere; text-wrap: balance; }
  .carpe-order__description { max-width: 65ch; font-size: 0.95rem; line-height: 1.75; overflow-wrap: anywhere; }
  .carpe-order__description :first-child { margin-block-start: 0; }
  .carpe-order__introduction { font-size: 0.85rem; line-height: 1.7; color: var(--color-foreground-muted); max-width: 62ch; margin-block: 14px 20px; }
  .carpe-order__browse { display: inline-flex; align-items: center; justify-content: space-between; gap: 32px; padding: 13px 18px; min-height: 48px; border-radius: var(--style-border-radius-buttons-primary, 6px); background: var(--color-primary-button-background); color: var(--color-primary-button-text); font-size: 0.82rem; font-weight: 600; text-decoration: none; transition: transform 180ms ease, background-color 180ms ease; }
  .carpe-order__browse:hover { transform: translateY(-2px); background: var(--color-primary-button-hover-background); color: var(--color-primary-button-hover-text); }
  .carpe-order__browse span { font-size: 1.1rem; }
  .carpe-order__steps { display: flex; flex-wrap: wrap; gap: 16px 24px; list-style: none; margin: 28px 0 0; padding: 20px 0 0; border-block-start: 1px solid var(--carpe-order-border); }
  .carpe-order__steps li { display: inline-flex; align-items: center; gap: 8px; font-size: 0.7rem; }
  .carpe-order__steps li > span { display: grid; place-items: center; width: 24px; height: 24px; border: 1px solid var(--carpe-order-border); border-radius: 50%; font-size: 0.6rem; font-variant-numeric: tabular-nums; }
  .carpe-order__options-heading { display: flex; justify-content: space-between; align-items: center; gap: 16px; margin-block-end: 20px; scroll-margin-block-start: calc(var(--header-height, 80px) + 24px); }
  .carpe-order__options-heading h2 { margin: 0; font-size: clamp(1.35rem, 2vw, 1.8rem); letter-spacing: -0.025em; }
  .carpe-order__options-heading .carpe-order__eyebrow { margin-block-end: 5px; }
  .carpe-order__count { flex-shrink: 0; padding: 7px 12px; border-radius: 999px; border: 1px solid var(--carpe-order-border); font-size: 0.75rem; background: var(--color-background); }
  .carpe-order__tabs { display: flex; gap: 8px; max-inline-size: 100%; min-inline-size: 0; overflow-x: auto; overscroll-behavior-inline: contain; padding-block: 4px 14px; margin-block-end: 10px; scrollbar-width: thin; }
  .carpe-order__tab { flex: 0 0 auto; min-block-size: 44px; padding: 11px 22px; border: 1px solid var(--carpe-order-border); border-radius: 999px; background: var(--color-background); color: var(--color-foreground); font: inherit; font-size: 0.8rem; cursor: pointer; transition: background-color 180ms ease, color 180ms ease; }
  .carpe-order__tab[aria-selected='true'] { background: var(--color-primary-button-background); color: var(--color-primary-button-text); border-color: var(--color-primary-button-background); }
  .carpe-order__tab:focus-visible { outline: 2px solid var(--color-foreground); outline-offset: 2px; }
  .carpe-order__group-status, .carpe-order__group-empty { font-size: 0.8rem; line-height: 1.5; }
  .carpe-order__group-status:empty { display: none; }
  .carpe-order__group-retry { margin-block-end: 16px; }
  .carpe-order__toolbar { position: sticky; inset-block-start: calc(var(--header-height, 80px) + 8px); z-index: 3; display: flex; align-items: center; flex-wrap: wrap; gap: 12px; margin-block-end: 14px; padding: 14px 18px; background: var(--color-background); border: 1px solid var(--carpe-order-border); border-radius: var(--style-border-radius-md, 12px); box-shadow: 0 10px 30px -22px rgb(var(--color-foreground-rgb) / 0.35); }
  .carpe-order__toolbar > p { margin: 0; }
  .carpe-order__toolbar > p:first-child { display: flex; align-items: center; gap: 10px; margin-inline-end: auto; font-size: 0.78rem; }
  .carpe-order__toolbar [data-order-count] { display: grid; place-items: center; min-width: 32px; height: 32px; padding-inline: 7px; border-radius: 8px; background: var(--carpe-order-soft); font-size: 1rem; font-variant-numeric: tabular-nums; }
  .carpe-order__toolbar > button { min-height: 44px; padding: 11px 16px; font-size: 0.78rem; }
  .carpe-order__toolbar > a { padding: 10px 6px; font-size: 0.75rem; text-underline-offset: 4px; color: inherit; }
  .carpe-order__status { flex-basis: 100%; font-size: 0.85rem; line-height: 1.5; overflow-wrap: anywhere; }
  .carpe-order__status[data-success='true'] { display: flex; align-items: center; gap: 10px; }
  .carpe-order__success-icon { display: inline-grid; place-items: center; flex: 0 0 28px; inline-size: 28px; block-size: 28px; border-radius: 50%; background: var(--color-success); color: white; --icon-stroke-width: 2px; }
  fly-to-cart.fly-to-cart--order {
    --width: 56px;
    --height: 56px;
    --offset-y: 0px;
    --x-timing: cubic-bezier(0.35, 0.05, 0.75, 1);
    --y-timing: cubic-bezier(0.08, 0.7, 0.3, 1.02);
    --scale-timing: cubic-bezier(0.4, 0, 0.8, 1);
    --icon-stroke-width: 1.5px;
    display: grid;
    place-items: center;
    padding: 12px;
    border-radius: 16px;
    overflow: visible;
    background: var(--carpe-flight-background);
    color: var(--carpe-flight-color);
    box-shadow: 0 10px 28px rgb(0 0 0 / 0.18);
    animation-duration: 900ms;
  }
  .carpe-order-flight__icon, .carpe-order-flight__icon svg { display: block; inline-size: 30px; block-size: 30px; }
  .carpe-order-flight__count { position: absolute; inset-block-start: -7px; inset-inline-end: -7px; min-inline-size: 25px; block-size: 25px; display: grid; place-items: center; padding-inline: 5px; border: 2px solid var(--carpe-flight-background); border-radius: 999px; background: var(--carpe-flight-color); color: var(--carpe-flight-background); font-family: var(--font-body--family); font-size: 11px; font-weight: 700; line-height: 1; font-variant-numeric: tabular-nums; }
  .carpe-order__scroll-hint { display: flex; align-items: center; gap: 8px; margin-block: 0 12px; font-size: 0.72rem; color: var(--color-foreground-muted); }
  .carpe-order__scroll-hint::before { content: '↔'; font-size: 1rem; }
  .carpe-order__scroll { position: relative; overflow-x: auto; overscroll-behavior-inline: contain; border: 1px solid var(--carpe-order-border); border-radius: var(--style-border-radius-md, 12px); background: var(--color-background); scrollbar-width: thin; scrollbar-color: rgb(var(--color-foreground-rgb) / 0.25) var(--carpe-order-soft); }
  .carpe-order__table { border-collapse: separate; border-spacing: 0; width: 100%; min-width: 840px; text-align: start; font-size: 0.85rem; }
  .carpe-order__table :is(th, td) { padding: 16px 18px; text-align: start; vertical-align: middle; border-block-end: 1px solid var(--carpe-order-border); }
  .carpe-order__table thead { background: var(--color-primary-button-background); color: var(--color-primary-button-text); }
  .carpe-order__table thead th { padding-block: 18px; font-size: 0.63rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.08em; white-space: nowrap; }
  .carpe-order__table tbody tr { background: var(--color-background); transition: background-color 180ms ease; }
  .carpe-order__table tbody tr:nth-child(even) { background: var(--carpe-order-soft); }
  .carpe-order__table tbody tr:focus-within { background: color-mix(in srgb, var(--color-background) 94%, var(--color-foreground)); }
  .carpe-order__table tbody tr:last-child > * { border-block-end: 0; }
  .carpe-order__media { width: 88px; }
  .carpe-order__media img { display: block; width: 58px; height: 58px; object-fit: contain; border-radius: 6px; }
  .carpe-order__swatch { display: block; width: 38px; height: 38px; border-radius: 50%; background: var(--carpe-swatch); border: 1px solid var(--carpe-order-border); box-shadow: 0 0 0 4px var(--color-background); }
  .carpe-order__code { white-space: nowrap; font-size: 0.75rem; font-variant-numeric: tabular-nums; }
  .carpe-order__product { min-width: 220px; max-width: 420px; font-weight: 500; line-height: 1.5; overflow-wrap: anywhere; }
  .carpe-order__product a { color: inherit; text-decoration: none; text-underline-offset: 4px; }
  .carpe-order__product a:hover { text-decoration: underline; }
  .carpe-order__table small { display: block; font-size: 0.7rem; font-weight: 400; margin-block-start: 6px; }
  .carpe-order__price { white-space: nowrap; font-weight: 650; font-size: 0.9rem; font-variant-numeric: tabular-nums; }
  .carpe-order__price s { display: block; font-size: 0.72rem; font-weight: 400; color: var(--color-foreground-muted); }
  .carpe-order__quantity { display: inline-flex; border: 1px solid var(--color-input-border); border-radius: 8px; overflow: hidden; transition: border-color 160ms ease, box-shadow 160ms ease; }
  .carpe-order__cart-presence { position: relative; display: flex; inline-size: fit-content; max-inline-size: 100%; margin-block-start: 8px; padding: 5px 9px; border: 1px solid color-mix(in srgb, var(--color-success) 22%, var(--color-background)); border-radius: 999px; color: var(--color-foreground); background: color-mix(in srgb, var(--color-success) 7%, var(--color-background)); font-size: 0.67rem; line-height: 1.35; font-weight: 500; }
  .carpe-order__cart-presence-visual { display: inline-flex; align-items: center; flex-wrap: wrap; gap: 5px; min-inline-size: 0; overflow-wrap: anywhere; }
  .carpe-order__cart-presence-visual svg { inline-size: 14px; block-size: 14px; flex-shrink: 0; color: var(--color-success); --icon-stroke-width: 1.6px; }
  .carpe-order__cart-presence-dot { opacity: 0.55; }
  .carpe-order__cart-presence bdi { font-weight: 700; font-variant-numeric: tabular-nums; }
  .carpe-order__quantity:focus-within { border-color: var(--color-foreground); box-shadow: 0 0 0 3px rgb(var(--color-foreground-rgb) / 0.06); }
  .carpe-order__quantity :is(button, input) { border: 0; border-radius: 0; color: var(--color-input-text); background: var(--color-input-background); min-height: 44px; }
  .carpe-order__quantity button { width: 44px; padding: 0; cursor: pointer; font-size: 18px; transition: background-color 160ms ease; }
  .carpe-order__quantity button:hover:not(:disabled) { background: color-mix(in srgb, var(--color-input-background) 92%, var(--color-input-text)); }
  .carpe-order__quantity input { width: 48px; padding: 4px; text-align: center; font-size: 16px; appearance: textfield; font-variant-numeric: tabular-nums; }
  .carpe-order__quantity input::-webkit-inner-spin-button, .carpe-order__quantity input::-webkit-outer-spin-button { appearance: none; margin: 0; }
  .carpe-order__quantity :disabled { opacity: 0.5; cursor: wait; }
  .carpe-order__quantity :focus-visible { outline-offset: -3px; }
  .carpe-order__pagination { display: flex; justify-content: center; gap: 20px; padding-block: 24px; }
  .carpe-order__pagination a { padding: 12px 24px; min-height: 44px; border: 1px solid var(--carpe-order-border); border-radius: 999px; background: var(--color-background); color: inherit; font-size: 0.8rem; text-decoration: none; transition: transform 160ms ease, border-color 160ms ease; }
  .carpe-order__pagination a:hover { border-color: var(--color-foreground); transform: translateY(-2px); }
  .carpe-order__pagination [aria-disabled='true'] { opacity: 0.5; cursor: wait; }
  .carpe-order__load-status { text-align: center; font-size: 0.85rem; }
  .carpe-order__load-status:empty, .carpe-order__status:empty { display: none; }
  .carpe-order:not([data-enhanced]) .carpe-order__enhanced, .carpe-order[data-enhanced] .carpe-order__fallback { display: none; }
  .carpe-order [hidden] { display: none; }
  .carpe-order-section[data-animate='true'] .carpe-order__intro { animation: carpe-order-enter 600ms ease both; }
  .carpe-order-section[data-animate='true'] .carpe-order__options-heading { animation: carpe-order-enter 600ms 100ms ease both; }
  .carpe-order-section[data-animate='true'] .carpe-order__table tbody tr { animation: carpe-order-row-enter 280ms ease both; }
  @keyframes carpe-order-enter { from { opacity: 0; transform: translateY(14px); } to { opacity: 1; transform: translateY(0); } }
  @keyframes carpe-order-row-enter { from { opacity: 0; } to { opacity: 1; } }
  @media (hover: hover) {
    .carpe-order__visual:hover .carpe-order__hero { transform: scale(1.035); }
    .carpe-order__table tbody tr:hover { background: color-mix(in srgb, var(--color-background) 94%, var(--color-foreground)); }
  }
  @media (max-width: 989px) {
    .carpe-order__steps { gap: 12px; }
    .carpe-order__steps li { font-size: 0.65rem; }
    .carpe-order__intro h1 { font-size: clamp(1.8rem, 3.8vw, 2.5rem); }
  }
  @media (max-width: 749px) {
    .carpe-order-section { padding-block-start: 18px; }
    .carpe-order__breadcrumbs { font-size: 0.65rem; gap: 7px; margin-block-end: 22px; }
    .carpe-order__breadcrumbs [aria-current] { max-width: 52%; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .carpe-order__intro { grid-template-columns: 1fr; gap: 24px; margin-block-end: 32px; }
    .carpe-order__image-frame { aspect-ratio: 1.45; padding: 24px 44px; max-height: 290px; }
    .carpe-order__hero { max-height: 190px; }
    .carpe-order__brand { margin-block-end: 12px; }
    .carpe-order__intro h1 { font-size: clamp(1.7rem, 7.2vw, 2.3rem); margin-block-end: 14px; text-wrap: initial; }
    .carpe-order__description { font-size: 0.86rem; line-height: 1.65; }
    .carpe-order__introduction { font-size: 0.8rem; }
    .carpe-order__steps { padding-block-start: 16px; margin-block-start: 20px; gap: 10px 16px; }
    .carpe-order__steps li { font-size: 0.63rem; }
    .carpe-order__steps li > span { width: 20px; height: 20px; }
    .carpe-order__toolbar { gap: 8px 12px; padding: 12px; }
    .carpe-order__toolbar > p:first-child { font-size: 0.7rem; gap: 6px; }
    .carpe-order__toolbar [data-order-clear] { margin-inline-start: auto; padding-inline: 8px; font-size: 0.7rem; }
    .carpe-order__toolbar [data-order-submit] { order: 2; flex-basis: 100%; }
    .carpe-order__toolbar > a { padding-inline: 0; font-size: 0.7rem; }
    .carpe-order__status { order: 3; }
    .carpe-order__table { min-width: 820px; }
    .carpe-order__table :is(th, td) { padding: 12px; }
    .carpe-order__table :is(th, td):last-child { position: sticky; inset-inline-end: 0; }
    .carpe-order__table thead th:last-child { background: var(--color-primary-button-background); z-index: 2; }
    .carpe-order__table tbody td:last-child { background: var(--color-background); z-index: 1; box-shadow: -6px 0 12px -10px rgb(var(--color-foreground-rgb) / 0.3); }
    .carpe-order__media { width: 76px; }
    .carpe-order__media img { width: 50px; height: 50px; }
  }
  @media (prefers-reduced-motion: reduce) {
    fly-to-cart.fly-to-cart--order { display: none; animation: none; }
    .carpe-order-section[data-animate='true'] :is(.carpe-order__intro, .carpe-order__options-heading, .carpe-order__table tbody tr) { animation: none; }
    .carpe-order :is(img, a, button, tr, .carpe-order__quantity) { transition: none; }
    .carpe-order__visual:hover .carpe-order__hero, .carpe-order__browse:hover, .carpe-order__pagination a:hover { transform: none; }
  }
{% endstylesheet %}
{% schema %}
{
  "name": "t:carpe_order.name",
  "enabled_on": { "templates": ["collection", "product"] },
  "settings": [
    { "type": "image_picker", "id": "image", "label": "t:carpe_order.image", "info": "t:carpe_order.image_info" },
    { "type": "color_scheme", "id": "color_scheme", "label": "t:carpe_order.color_scheme", "default": "scheme-1" },
    { "type": "range", "id": "products_per_page", "label": "t:carpe_order.page_size", "min": 12, "max": 48, "step": 12, "default": 24 },
    { "type": "checkbox", "id": "auto_load", "label": "t:carpe_order.auto_load", "default": true },
    { "type": "checkbox", "id": "show_images", "label": "t:carpe_order.show_images", "default": true },
    { "type": "checkbox", "id": "show_barcode", "label": "t:carpe_order.show_barcode", "default": true },
    { "type": "select", "id": "background_style", "label": "t:carpe_order.background_style", "options": [ { "value": "paper", "label": "t:carpe_order.background_paper" }, { "value": "plain", "label": "t:carpe_order.background_plain" } ], "default": "paper" },
    { "type": "checkbox", "id": "enable_animation", "label": "t:carpe_order.enable_animation", "default": true }
  ]
}
{% endschema %}
